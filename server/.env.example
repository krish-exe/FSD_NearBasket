# Copy this file to .env (never commit .env)

# Local MongoDB, or your MongoDB Atlas connection string when deployed
MONGODB_URI=mongodb://127.0.0.1:27017/nearbasket

# Any long random string; signs login tokens
JWT_SECRET=replace-with-a-long-random-string

PORT=5000

# Website address(es) allowed to call this API, comma-separated
CLIENT_ORIGIN=http://localhost:5173

# Password given to every seeded demo account (vendors and the demo customer)
SEED_PASSWORD=Demo@1234

# Shops are only shown to (and deliver to) customers within this many km
DELIVERY_RADIUS_KM=5
